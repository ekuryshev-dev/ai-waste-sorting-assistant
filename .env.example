# Copy this file to .env in the repository root and fill in the values. Never commit .env.

# Neon PostgreSQL, shared by all three services
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Dashboard: 1 uses a local SQLite file instead of Neon
USE_SQLITE=0

# Assistant: leave empty to use the mock AI client
OPENAI_API=

# Shared secret between classification and dashboard
ANALYTICS_INGEST_KEY=replace-with-your-own-key

# Classification: addresses of the other services (local defaults)
ASSISTANT_FALLBACK_URL=http://127.0.0.1:8000
ANALYTICS_URL=http://127.0.0.1:8002
